# Copy to .env and fill in your own values. Never commit .env.
#
# Everything here is inlined into the JS bundle by Expo at build time, so treat
# these as configuration rather than secrets — anything that must stay private
# belongs in a Supabase Edge Function environment variable instead.

# Supabase project
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# n8n orchestration webhooks
EXPO_PUBLIC_MEAL_ANALYSIS_WEBHOOK_URL=https://your-n8n-host/webhook/your-meal-analysis-id
EXPO_PUBLIC_MEAL_PLAN_WEBHOOK_URL=https://your-n8n-host/webhook/your-meal-plan-id
EXPO_PUBLIC_PROGRESS_PHOTO_WEBHOOK_URL=https://your-n8n-host/webhook/your-progress-photo-id

# Support form endpoint
EXPO_PUBLIC_SUPPORT_WEBHOOK_URL=https://your-support-webhook-endpoint

# Supabase Edge Functions
EXPO_PUBLIC_FORGOT_PASSWORD_FN_URL=https://your-project-ref.supabase.co/functions/v1/send-reset-caltrack
EXPO_PUBLIC_IAP_VERIFY_URL=https://your-project-ref.supabase.co/functions/v1/iap-verify-google

# Shared secret the password-reset Edge Function checks.
# Must match the value set in the Supabase project's function environment.
EXPO_PUBLIC_FUNCTION_SECRET_KEY=your-function-shared-secret
